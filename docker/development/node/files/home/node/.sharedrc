# fnm
export PATH=$HOME/.fnm:$PATH

# local bin
export PATH=$HOME/.local/bin:$PATH

export HISTSIZE=5000
export SAVEHIST=100000

export EDITOR='vim'

alias cls="printf '\033c'; printf '\033[3J'"

alias ls='ls -ahl --color=auto'
alias mkdir='mkdir -pv'

alias cp='cp -i'
alias ln='ln -i'
alias mv='mv -i'
alias rm='rm -i'

# gemini: yolo (auto-approve all tools) can't be set via settings.json, only via flag
alias gemini='gemini --yolo'

# Reset per-harness state (bind-mounted from .home within this repository, see docker-compose.yml),
# keeping only auth and settings (plus, for pi, the installed packages).

antigravity-reset() {
    find ~/.gemini/antigravity-cli -mindepth 1 -maxdepth 1 \
        ! -name 'settings.json' \
        ! -name '*auth*' \
        ! -name '*token*' \
        -exec rm -rf -- {} +
}

claude-reset() {
    find ~/.claude -mindepth 1 -maxdepth 1 \
        ! -name '.claude.json' \
        ! -name '.credentials.json' \
        ! -name 'settings.json' \
        -exec rm -rf -- {} +
}

codex-reset() {
    find ~/.codex -mindepth 1 -maxdepth 1 \
        ! -name 'auth.json' \
        ! -name 'config.toml' \
        -exec rm -rf -- {} +
}

gemini-reset() {
    find ~/.gemini -mindepth 1 -maxdepth 1 \
        ! -name 'antigravity-cli' \
        ! -name 'config' \
        ! -name 'oauth_creds.json' \
        ! -name 'settings.json' \
        -exec rm -rf -- {} +
}

opencode-reset() {
    find ~/.config/opencode -mindepth 1 -maxdepth 1 \
        ! -name 'opencode.jsonc' \
        ! -name 'tui.json' \
        -exec rm -rf -- {} +
    find ~/.local/share/opencode -mindepth 1 -maxdepth 1 \
        ! -name 'auth.json' \
        -exec rm -rf -- {} +
}

pi-reset() {
    find ~/.pi/agent -mindepth 1 -maxdepth 1 \
        ! -name 'auth.json' \
        ! -name 'git' \
        ! -name 'settings.json' \
        -exec rm -rf -- {} +
}

harness-reset() {
    antigravity-reset
    claude-reset
    codex-reset
    gemini-reset
    opencode-reset
    pi-reset
}

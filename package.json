{
  "name": "@chubbyts/petstore",
  "version": "1.0.0",
  "description": "An api skeleton using mongodb for chubbyts-framework.",
  "type": "module",
  "keywords": [
    "chubbyts",
    "framework",
    "skleton",
    "api",
    "mongodb"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/petstore",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "command": "ts-node bin/console.ts",
    "cs-fix": "prettier --write bin bootstrap config src tests *.ts",
    "cs": "prettier --check bin bootstrap config src tests *.ts",
    "develop:debug": "tsx watch --inspect=0.0.0.0:8888 bootstrap/index.ts",
    "develop": "tsx watch bootstrap/index.ts",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix bin bootstrap config src tests *.ts",
    "lint": "oxlint bin bootstrap config src tests *.ts",
    "start:debug": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm run develop:debug",
    "start": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm run develop",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test": "vitest --config vitest.config.ts"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@chubbyts/chubbyts-decode-encode": "^2.8.1",
    "@chubbyts/chubbyts-dic": "^2.4.2",
    "@chubbyts/chubbyts-dic-config": "^2.4.1",
    "@chubbyts/chubbyts-dic-types": "^2.4.1",
    "@chubbyts/chubbyts-framework": "^4.2.1",
    "@chubbyts/chubbyts-framework-router-path-to-regexp": "^4.2.0",
    "@chubbyts/chubbyts-http": "^3.2.1",
    "@chubbyts/chubbyts-http-api": "^1.3.1",
    "@chubbyts/chubbyts-http-cors": "^3.1.1",
    "@chubbyts/chubbyts-http-error": "^3.6.1",
    "@chubbyts/chubbyts-http-node": "^1.2.1",
    "@chubbyts/chubbyts-http-oidc": "^1.1.1",
    "@chubbyts/chubbyts-http-types": "^4.3.1",
    "@chubbyts/chubbyts-log-types": "^3.4.2",
    "@chubbyts/chubbyts-mongodb": "^2.4.2",
    "@chubbyts/chubbyts-pino-adapter": "^3.4.2",
    "commander": "^15.1.0",
    "mongodb": "^7.9.1",
    "openapi3-ts": "^4.6.2",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-function-mock": "^2.4.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.3",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/mongodb-uri": "^0.9.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-fetch": "^4.1.0",
    "mongodb-uri": "^0.9.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}

{
  "name": "@chubbyts/petstore",
  "version": "1.0.0",
  "description": "An api skeleton using postgres for chubbyts-framework.",
  "type": "module",
  "keywords": [
    "chubbyts",
    "framework",
    "skleton",
    "api",
    "postgres"
  ],
  "author": "Dominik Zogg",
  "license": "MIT",
  "repository": "chubbyts/petstore",
  "scripts": {
    "build": "rm -Rf dist && tsc",
    "command": "ts-node bin/console.ts",
    "cs-fix": "prettier --write bin bootstrap config src tests *.ts",
    "cs": "prettier --check bin bootstrap config src tests *.ts",
    "db:push": "drizzle-kit push",
    "develop:debug": "tsx watch --inspect=0.0.0.0:8888 bootstrap/index.ts",
    "develop": "tsx watch bootstrap/index.ts",
    "infection": "stryker run",
    "lint-fix": "oxlint --fix bin bootstrap config src tests *.ts",
    "lint": "oxlint bin bootstrap config src tests *.ts",
    "start:debug": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm db:push && pnpm run develop:debug",
    "start": "pnpm install && pnpm run lint-fix && pnpm run cs-fix && pnpm db:push && pnpm run develop",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test": "vitest --config vitest.config.ts"
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@chubbyts/chubbyts-decode-encode": "^2.5.2",
    "@chubbyts/chubbyts-dic": "^2.3.1",
    "@chubbyts/chubbyts-dic-config": "^2.3.1",
    "@chubbyts/chubbyts-dic-types": "^2.3.1",
    "@chubbyts/chubbyts-framework": "^3.5.1",
    "@chubbyts/chubbyts-framework-router-path-to-regexp": "^3.4.1",
    "@chubbyts/chubbyts-http-error": "^3.5.1",
    "@chubbyts/chubbyts-log-types": "^3.3.1",
    "@chubbyts/chubbyts-pino-adapter": "^3.3.1",
    "@chubbyts/chubbyts-undici-api": "^2.4.2",
    "@chubbyts/chubbyts-undici-cors": "^1.4.1",
    "@chubbyts/chubbyts-undici-oidc": "^1.3.2",
    "@chubbyts/chubbyts-undici-server": "^1.3.1",
    "@chubbyts/chubbyts-undici-server-node": "^1.3.1",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "openapi3-ts": "^4.6.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chubbyts/chubbyts-function-mock": "^2.3.1",
    "@chubbyts/chubbyts-oxlint": "^1.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "connection-string": "^5.0.0",
    "cross-fetch": "^4.1.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024"
}

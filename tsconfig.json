        "erasableSyntaxOnly": true,
        "esModuleInterop": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "./dist",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024"
    },
    "include": [
        "bin",
        "bootstrap",
        "config",
        "src",
        "drizzle.config.ts"
    ]
}

{
    "compilerOptions": {
        "erasableSyntaxOnly": true,
        "esModuleInterop": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "outDir": "dist",
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2024",
        "types": ["node"]
    },
    "include": [
        "bin",
        "bootstrap",
        "config",
        "src"
    ]
}
